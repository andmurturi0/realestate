# Faza 10 §11 — production environment template. Copy to `.env` on the
# production host and fill in the real secrets; never commit the filled-in
# file. Differences from `.env.example` are called out below; everything
# else (DB/Storage/Mail placeholders) is identical and still needs real
# values.

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
# Never true in production — with debug on, an unhandled exception renders
# a full stack trace (file paths, query bindings, env values) to any visitor
# who triggers it. Faza 10's designed error pages (bootstrap/app.php) are
# also skipped whenever this is true, so leaving it on defeats both.
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=sq
APP_FALLBACK_LOCALE=sq
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' is noisy and can leak sensitive request context into log storage.
LOG_LEVEL=error

# Supabase PostgreSQL — use the Session pooler (port 5432), NOT the
# Transaction pooler, which breaks prepared statements.
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxx
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS-only session cookie — must be true once the app is served over TLS
# (APP_URL above is https://), or the browser will refuse to send it back
# and every visitor gets logged out on each request.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# The `locale` and `appearance` cookies are deliberately excluded from
# Laravel's cookie encryption (bootstrap/app.php's encryptCookies except
# list) — they're written directly by client-side JS as plain values on
# purpose, so this isn't something to configure per-environment here.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=supabase
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Storage (S3-compatible) — used by the "supabase" disk.
# Keys come from Supabase → Project Settings → Storage → S3 access keys.
# AWS_BUCKET is the Supabase Storage bucket name (e.g. "properties").
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=properties
AWS_URL=https://xxxxxxxx.supabase.co/storage/v1/object/public/properties
AWS_ENDPOINT=https://xxxxxxxx.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
